# Copy to .env (or export in your shell) and adjust as needed.

# Local Ollama server
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_S=25

# Set to 0 to run fully deterministic (no LLM phrasing)
USE_OLLAMA=1

# Never enable in production
FLASK_DEBUG=0

# Backend port (5001 default — macOS AirPlay Receiver occupies 5000).
# If you change it, update Frontend/proxy.conf.json to match.
PORT=5001

# Comma-separated allowed origins (restrict in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to the built RAG index (python rag_index.py creates it)
# RAG_INDEX_PATH=/absolute/path/to/rag_data/rag_index.json
