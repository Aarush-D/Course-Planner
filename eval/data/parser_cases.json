{
 "meta": {
  "name": "parser_cases",
  "synthetic": true,
  "real_student_data": false,
  "description": "Hand-written messages in the style of student chat, NOT sampled from real users and not derived from any transcript. They were written by the harness author from knowledge of how students phrase these things; the engine's own regexes were not consulted while labeling.",
  "label_policy": "Labels record what the student MEANS, not what the engine currently returns. Fields omitted from `expected` mean 'unchanged': major and start_year stay at the context value, and added/removed/wanted/excluded are empty. Every case is therefore also a false-positive check on every field it does not mention.",
  "defaults": {
   "major": "CMPSC",
   "completed": [],
   "start_year": 2026
  },
  "fields": {
   "major": "response state.dept",
   "start_year": "response state.startYear",
   "added": "state.completed minus context.completed",
   "removed": "context.completed minus state.completed",
   "wanted": "state.wantedCourses",
   "excluded": "state.excludedCourses"
  },
  "label_revisions": []
 },
